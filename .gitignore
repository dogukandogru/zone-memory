# Bagimliliklar
node_modules/

# Paketleme ciktilari
release/
dist/
out/
build/*.blockmap

# Veri deposu (mumlar ve hafiza vektorleri)
# Not: gercek depo uygulama veri klasorundedir, bunlar yerel denemeler icindir.
# Kural koke sabitlenmistir: src/core/data kaynak kodudur, yok sayilmamalidir.
/data/
*.bin
*.bin.tmp
*.vec
*.vec.tmp
*_memory.json
# Testlerin kullandigi kucuk ornek dosyalar izlenir.
!test/fixtures/**

# Gecici ve gunluk dosyalari
tmp/
temp/
logs/
*.log
npm-debug.log*

# Isletim sistemi ve editor artiklari
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Yerel ortam degiskenleri (API anahtarlari)
.env
.env.local

# Uretilen kurulum paketleri
release/
src/build-info.json
